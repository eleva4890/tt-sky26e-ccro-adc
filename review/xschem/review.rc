source $env(PDK_ROOT)/sky130A/libs.tech/xschem/xschemrc
set XSCHEM_LIBRARY_PATH "[pwd]:$XSCHEM_SHAREDIR/xschem_library:$XSCHEM_LIBRARY_PATH"
set lvs_netlist 1
set spiceprefix 1
# Suppress simulation-only annotations while inspecting mask connectivity.
foreach layer {15 16 17} {set enable_layer($layer) 0}

